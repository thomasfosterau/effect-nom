{
  "name": "effect-nom",
  "version": "0.1.0",
  "description": "Parser combinators for Effect, ported from Rust's nom and winnow",
  "keywords": [
    "effect",
    "parser",
    "parser-combinators",
    "nom",
    "winnow",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.28.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "bench": "node --experimental-strip-types bench/json.bench.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "effect": "4.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
